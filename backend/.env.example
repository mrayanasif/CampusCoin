# Campus Coin API - environment template
# Copy to `.env` and fill in real values. NEVER commit real secrets.
# Required for: node api/index.js (from backend/).

# HTTP port used when running the API locally
PORT=5000

# MongoDB connection string (MongoDB Atlas or local mongod)
DBURI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# JWT signing secret - generate a long random value (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-long-random-secret
# Optional: JWT lifetime (defaults to 7d)
JWT_EXPIRE=7d

# Public URL of the frontend, used in password-reset and report-share emails.
# In deployment set this to the deployed frontend origin, e.g. https://your-frontend.example.com
FRONTEND_URL=http://localhost:5173

# Outbound SMTP for password reset and report emails (Gmail app password shown as example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-smtp-app-password

# Optional: "production" disables the development password-reset token fallback
NODE_ENV=development
